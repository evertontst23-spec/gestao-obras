# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon

# Chave secreta: usada SOMENTE no servidor para cadastrar usuários. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# Segredo da rota /api/cron/alertas (alternativa ao pg_cron)
CRON_SECRET=troque-por-um-valor-aleatorio-longo
